# Editors / IDE
.vscode/*
!.vscode/extensions.json
.idea/
*.swp

# OS junk
.DS_Store
Thumbs.db
desktop.ini

# Node (only used for one-off tooling: PurgeCSS, image/video encoding…)
node_modules/
npm-debug.log*
yarn-error.log*

# Build output (not used today — the site is served as-is)
dist/

# Local secrets & machine-specific config
# (firebase.config.js is deliberately NOT ignored: GitHub Pages serves the site straight
#  from this repo, so an ignored config would ship a production site with no Firebase.
#  Those keys are public by design — App Check and its domain allowlist are what protect
#  the counters, not the secrecy of the config.)
.env
.env.local

# Scratch files
*.bak
*.orig
*.tmp
